{
	"name": "obsidian-inkflow",
	"version": "0.1.0",
	"description": "Handwriting-first note taking for Obsidian. Write with a stylus, let AI turn it into Markdown/LaTeX, and confirm only what's ambiguous.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src --ext .ts"
	},
	"keywords": [
		"obsidian-plugin",
		"handwriting",
		"stylus",
		"ocr"
	],
	"author": "jtourian",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^8.57.0",
		"obsidian": "^1.5.7-1",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3"
	}
}
